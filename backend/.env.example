# Studora backend — safe placeholder environment example.
# Copy to `.env` locally and fill in real values. Never commit the real `.env`.

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/studora
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional and normally left blank. Only set this if your project still has
# unexpired tokens signed with a legacy HS256 secret (visible under
# Project Settings -> API -> JWT Settings -> "Legacy JWT Secret" in the
# Supabase dashboard). A new project verifies fine without it — the active
# signing key is fetched automatically from SUPABASE_URL's JWKS endpoint.
# Never commit a real value here.
SUPABASE_LEGACY_JWT_SECRET=
