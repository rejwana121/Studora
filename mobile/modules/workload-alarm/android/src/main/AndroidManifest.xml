<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Merged additively into the app's final manifest by the standard
         Android Gradle Plugin manifest merger — no app-level manifest edits
         needed. Exactly the three permissions Checkpoint 4B approved: no
         SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="expo.modules.workloadalarm.WorkloadAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
